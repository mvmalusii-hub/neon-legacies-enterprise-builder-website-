# Copy to .env and fill in what you use. Never commit the real .env.
DEEPSEEK_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key

# Which adapter to use by default: deepseek | qwen
PROVIDER=deepseek

# Model ids – pin them so a provider-side alias change cannot move under you.
DEEPSEEK_MODEL=deepseek-chat
QWEN_MODEL=qwen-plus

LOG_LEVEL=INFO
LOG_FORMAT=json
