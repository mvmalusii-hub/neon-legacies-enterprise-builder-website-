# ==========================================================
# Cloudflare Pages / Cloudflare Workers static header rules
# ==========================================================
# This file is consumed by Cloudflare Pages (and `wrangler pages
# dev`). GitHub Pages ignores it, which is why the same headers are
# also documented as Response Header Transform Rules in
# cloudflare/README.md — apply them there when the GitHub Pages
# origin is proxied (orange cloud) through Cloudflare.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# ==========================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://script.google.com https://docs.google.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://docs.google.com https://cloudflareinsights.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com https://docs.google.com; manifest-src 'self'; worker-src 'self'

# HTML: never let a CDN/browser serve a stale page
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static assets are fingerprinted by content — cache them hard at the edge
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=3600

/main.css
  Cache-Control: public, max-age=3600

# Never cache machine-readable files
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
